# SVALINN-GO Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================================================
# REQUIRED: API & Security Keys
# ============================================================================

# God Mode authentication key for /api/v9/* endpoints
# CRITICAL: This key bypasses all middleware and grants full administrative access
# Generate a strong random key (32+ characters, alphanumeric + symbols)
SVALINN_GOD_KEY=change-me-to-a-strong-random-string

# API key for programmatic access (threat reporting, actor queries, etc.)
# Generate a strong random key
SVALINN_API_KEY=change-me-to-another-strong-random-string

# ============================================================================
# OPTIONAL: Reserse Advanced Tracking (Two-stage Actor Correlation)
# ============================================================================

# Reserse module username (advanced attacker profiling)
SVALINN_RESERSE_USER=your-reserse-username

# Reserse module password (keep secure)
SVALINN_RESERSE_PASS=your-reserse-password

# ============================================================================
# OPTIONAL: AEGIS Ecosystem Integration
# ============================================================================

# ODIN DNS Intelligence API key (for HEIMDALL threat correlation)
ODIN_API_KEY=your-odin-api-key

# ============================================================================
# INFRASTRUCTURE: Customize for your Deployment
# ============================================================================

# Main SVALINN HTTP server listen address (e.g., "127.0.0.1:10000")
SVALINN_HTTP_ADDR=127.0.0.1:10000

# SVALINN HTTPS server listen address (empty to disable)
SVALINN_HTTPS_ADDR=127.0.0.1:10443

# Ecosystem allowed IPs (comma-separated, RFC 5737 TEST-NET examples below)
# Restrict /api/v1/shield/threats, /api/v1/heimdall/report, etc. to these IPs
ECOSYSTEM_ALLOWED_IPS=203.0.113.20,203.0.113.10

# Database path (relative to working directory or absolute path)
SVALINN_DB_PATH=./data/svalinn.db

# GeoIP database path
SVALINN_GEOIP_DB=/app/data/geoip/GeoLite2-Country.mmdb

# ML Engine URL (for threat scoring via Python bridge)
ML_ENGINE_URL=http://localhost:8000

# ============================================================================
# CONFIGURATION: Tuning & Thresholds
# ============================================================================

# WAF block confidence threshold (0.0-1.0; higher = stricter)
WAF_BLOCK_THRESHOLD=0.8

# DDoS challenge threshold (requests per second)
DDOS_CHALLENGE_THRESHOLD=50

# DDoS throttle threshold (requests per second)
DDOS_THROTTLE_THRESHOLD=100

# DDoS block threshold (requests per second)
DDOS_BLOCK_THRESHOLD=200

# Maximum concurrent actors tracked in memory
MAX_ACTORS=100000

# Behavioral deviation threshold for anomaly detection (0.0-1.0)
BEHAVIORAL_DEVIATION_THRESHOLD=0.7

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================================
# DEPLOYMENT: Production vs. Development
# ============================================================================

# Server mode: "production", "staging", or "development"
SERVER_MODE=production

# Enable ML-powered threat detection (requires ML Engine running)
ML_ENABLED=true

# Enable deception mechanisms (honeypots, canary tokens)
DECEPTION_ENABLED=true

# Enable behavioral analysis engine
BEHAVIORAL_ANALYSIS_ENABLED=true

# ============================================================================
# SIEM / THREAT INTELLIGENCE
# ============================================================================

# Enable MITRE ATT&CK mapping and correlation
MITRE_ATTACK_ENABLED=true

# Enable STIX-formatted threat intelligence
STIX_ENABLED=true

# Enable CVE feed ingestion
CVE_FEED_ENABLED=false

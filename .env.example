# SVALINN-GO Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================================================
# REQUIRED: API & Security Keys
# ============================================================================

# God Mode authentication key for /api/v9/* endpoints
# CRITICAL: This key bypasses all middleware and grants full administrative access
# Generate a strong random key (32+ characters, alphanumeric + symbols)
SVALINN_GOD_KEY=change-me-to-a-strong-random-string

# API key for programmatic access (threat reporting, actor queries, etc.)
# Generate a strong random key
SVALINN_API_KEY=change-me-to-another-strong-random-string

# ============================================================================
# REQUIRED: Reserse Advanced Tracking (Two-stage Actor Correlation)
# ============================================================================
# The server refuses to start if these are empty (fail-closed by design).

# Reserse module username (advanced attacker profiling)
SVALINN_RESERSE_USER=your-reserse-username

# Reserse module password (keep secure)
SVALINN_RESERSE_PASS=your-reserse-password

# ============================================================================
# OPTIONAL: MECOB Ecosystem Integration
# ============================================================================

# ODIN DNS Intelligence API key (for HEIMDALL threat correlation)
ODIN_API_KEY=your-odin-api-key

# ============================================================================
# INFRASTRUCTURE & ADVANCED TUNING
# ============================================================================

# Listen address/port, database path, GeoIP database path, the ecosystem
# source-IP allowlist, ML engine settings, WAF/DDoS thresholds, actor memory
# limits, and feature toggles (deception/SIEM/CVE-feed/etc.) are all
# configured directly in configs/svalinn.yaml -- not via environment
# variables. See that file for the full list of options.

# WAF/DDoS thresholds, actor memory limits, ML/deception/SIEM/CVE-feed toggles,
# logging level, and server mode are all configured directly in
# configs/svalinn.yaml -- not via environment variables. See that file for
# the full list of options.
